# Agent/03_Paradigm/target.env — the ONE file you edit when switching paradigm.
#
#   ./Agent/03_Paradigm/make_prompts.sh --list    # discover every paradigm/SET available (start here)
#   ./Agent/03_Paradigm/make_prompts.sh --check   # verify the paths below exist
#   ./Agent/03_Paradigm/make_prompts.sh           # print the conversion prompts
#   ./Agent/03_Paradigm/make_prompts.sh demo      # print the HTML-demo prompts

# ── Which paradigm? ───────────────────────────────────────────────────────────
PROJECT="OLM"                        # OLM | APPL | FLOW
PARADIGM="OLM_paradigm_short"              # OLM_paradigm | OLM_paradigm_short | APPL_paradigm | ...
LANG="english"                       # english | german

# ── Set naming (NOT regular across the repo — set both explicitly) ────────────
SET_PRESENTATION="SET_short"         # folder under paradigm/presentation/<PARADIGM>/
SET_PSYCHOPY=""                      # LEAVE EMPTY ("") if outputs sit directly in <PARADIGM>/
                                     #   — this is the case for the _short paradigms.

# ── The experiment file inside the presentation SET folder ───────────────────
EXP_FILE="Locato10_fMRT.exp"

# ── Output filename for the generated PsychoPy script ────────────────────────
# Empty = auto-derive as <PROJECT>_<SET>_<LANG><OUT_SUFFIX>.py
OUT_BASENAME="OLM_short_version_english_generated.py"
OUT_SUFFIX="_generated"

# ── Scenarios worth naming explicitly in the prompt ──────────────────────────
KEY_SCENARIOS="03_learning.sce and 04_AFC.sce"

# ── Templates (Agent/03_Paradigm/template/) ──────────────────────────────────────────────
REFERENCE="Agent/03_Paradigm/template/paradigm_template.py"      # PsychoPy style reference
DEMO_TEMPLATE="Agent/03_Paradigm/template/paradigm_demo.html"    # interactive HTML demo template

# ── HTML demo (Research_BEEHub integration) ──────────────────────────────────
# The demo is derived from the SHORT version of the paradigm. If no short-version
# .py exists, the demo prompts will create one first.
DEMO_BASENAME="OLM_short_demo.html"  # empty = <PROJECT>_short_demo.html
DEMO_TITLE="OLMM"                    # shown in the browser tab / header
DEMO_N_REPS="2"                      # learning repetitions in the DEMO (keep 1-2)


# ══════════════════════════════════════════════════════════════════════════════
# KNOWN CONFIGURATIONS — copy the block you need over the values above.
# ══════════════════════════════════════════════════════════════════════════════
#
# ── OLM full, Set A ──
#   PROJECT="OLM"; PARADIGM="OLM_paradigm"
#   SET_PRESENTATION="SET_A";  SET_PSYCHOPY="Set_A"
#   EXP_FILE="Locato30_VersionA_fMRI.exp";  OUT_BASENAME=""
#
# ── OLM full, Set B ──
#   PROJECT="OLM"; PARADIGM="OLM_paradigm"
#   SET_PRESENTATION="SET_B";  SET_PSYCHOPY="Set_B"
#   EXP_FILE="<check: the .exp inside SET_B>";  OUT_BASENAME=""
#
# ── OLM SHORT ──  (no psychopy subfolder, different output name, NO LOGS)
#   PROJECT="OLM"; PARADIGM="OLM_paradigm_short"
#   SET_PRESENTATION="SET_short";  SET_PSYCHOPY=""
#   EXP_FILE="Locato10_fMRT.exp"
#   OUT_BASENAME="OLM_short_version_english_generated.py"
#   DEMO_BASENAME="OLM_short_demo.html";  DEMO_TITLE="OLMM"
#
# ── APPL full, Set 1 ──
#   PROJECT="APPL"; PARADIGM="APPL_paradigm"
#   SET_PRESENTATION="Set1_MRI";  SET_PSYCHOPY="Set_1"
#   EXP_FILE="<check>";  OUT_BASENAME=""
#   DEMO_TITLE="APPL"
