        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="start_pos = [0, (- 400)];&amp;#10;threshold_y = (start_pos[1] + 100);&amp;#10;corridor_width = 60;&amp;#10;movement_initiated = false;&amp;#10;threshold_crossed = false;&amp;#10;fix_timer = new util.Clock();&amp;#10;max_wait_time = 5.0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Initialize variables&amp;#10;start_pos = [0, -400]  # Start box position&amp;#10;threshold_y = start_pos[1] + 100  # 100px above start box&amp;#10;corridor_width = 300  # Width of movement corridor&amp;#10;&amp;#10;movement_initiated = False&amp;#10;threshold_crossed = False&amp;#10;fix_timer = core.Clock()&amp;#10;max_wait_time = 5.0  # 5000ms max wait for movement&amp;#10;timeout_occurred = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Get current mouse position&amp;#10;current_pos = mouse_fix.getPos()&amp;#10;&amp;#10;# Check if mouse is moving upward&amp;#10;if current_pos[1] &gt; start_pos[1] and not movement_initiated:&amp;#10;    movement_initiated = True&amp;#10;&amp;#10;# Check if mouse is within corridor&amp;#10;in_corridor = abs(current_pos[0] - start_pos[0]) &lt;= corridor_width/2&amp;#10;&amp;#10;# Check if threshold is crossed within corridor&amp;#10;if movement_initiated and in_corridor and current_pos[1] &gt;= threshold_y and not threshold_crossed:&amp;#10;    threshold_crossed = True&amp;#10;    continueRoutine = False  # Move to stimulus routine&amp;#10;&amp;#10;# Check for timeout&amp;#10;if fix_timer.getTime() &gt;= max_wait_time and not movement_initiated:&amp;#10;    timeout_occurred = True&amp;#10;    continueRoutine = False  # End routine&amp;#10;    &amp;#10;    &amp;#10;# Record mouse data every frame&amp;#10;current_pos = mouse_tracking.getPos()&amp;#10;current_time = mouse_track_clock.getTime()&amp;#10;mouse_track_data['x'].append(current_pos[0])&amp;#10;mouse_track_data['y'].append(current_pos[1])&amp;#10;mouse_track_data['time'].append(current_time)&amp;#10;&amp;#10;# Calculate velocity (if not first frame)&amp;#10;if len(mouse_track_data['time']) &gt; 1:&amp;#10;    dt = current_time - prev_time&amp;#10;    if dt &gt; 0:  # Avoid division by zero&amp;#10;        vx = (current_pos[0] - prev_x) / dt&amp;#10;        vy = (current_pos[1] - prev_y) / dt&amp;#10;    else:&amp;#10;        vx, vy = 0, 0&amp;#10;    mouse_track_data['velocity_x'].append(vx)&amp;#10;    mouse_track_data['velocity_y'].append(vy)&amp;#10;else:&amp;#10;    mouse_track_data['velocity_x'].append(0)&amp;#10;    mouse_track_data['velocity_y'].append(0)&amp;#10;&amp;#10;# Record clicks&amp;#10;buttons = mouse_tracking.getPressed()&amp;#10;mouse_track_data['clicks'].append(buttons[0])  # Left button&amp;#10;if buttons[0] == 1 and len(mouse_track_data['clicks']) &gt; 1 and mouse_track_data['clicks'][-2] == 0:&amp;#10;    # New click detected&amp;#10;    mouse_track_data['click_time'].append(current_time)&amp;#10;&amp;#10;# Update previous values for next frame&amp;#10;prev_x, prev_y = current_pos&amp;#10;prev_time = current_time" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="current_pos = mouse_fix.getPos();&amp;#10;if (((current_pos[1] &gt; start_pos[1]) &amp;&amp; (! movement_initiated))) {&amp;#10;    movement_initiated = true;&amp;#10;}&amp;#10;in_corridor = (Math.abs((current_pos[0] - start_pos[0])) &lt;= (corridor_width / 2));&amp;#10;if ((((movement_initiated &amp;&amp; in_corridor) &amp;&amp; (current_pos[1] &gt;= threshold_y)) &amp;&amp; (! threshold_crossed))) {&amp;#10;    threshold_crossed = true;&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;if ((fix_timer.getTime() &gt;= max_wait_time)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Record movement data&amp;#10;thisExp.addData('movement_initiated', movement_initiated)&amp;#10;thisExp.addData('threshold_crossed', threshold_crossed)&amp;#10;thisExp.addData('movement_time', fix_timer.getTime())&amp;#10;thisExp.addData('timeout_occurred', timeout_occurred)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_12" valType="code" updates="None" name="name"/>
      </CodeComponent>
