      <CodeComponent name="code_11" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="hold_timer = new util.Clock();&amp;#10;hold_complete = false;&amp;#10;hold_duration = 0.5;&amp;#10;in_start_box = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Reset variables&amp;#10;hold_timer = core.Clock()&amp;#10;hold_complete = False&amp;#10;hold_duration = 0.5  # 500ms required hold time&amp;#10;in_start_box = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Get current mouse position&amp;#10;current_pos = mouse_start.getPos()&amp;#10;&amp;#10;# Check if mouse is in start box - by calculating if position is within box boundaries&amp;#10;start_box_left = start_box.pos[0] - start_box.size[0]/2&amp;#10;start_box_right = start_box.pos[0] + start_box.size[0]/2&amp;#10;start_box_bottom = start_box.pos[1] - start_box.size[1]/2  &amp;#10;start_box_top = start_box.pos[1] + start_box.size[1]/2&amp;#10;&amp;#10;# Check if mouse position is within box boundaries&amp;#10;mouse_in_box = (current_pos[0] &gt;= start_box_left and &amp;#10;                current_pos[0] &lt;= start_box_right and &amp;#10;                current_pos[1] &gt;= start_box_bottom and &amp;#10;                current_pos[1] &lt;= start_box_top)&amp;#10;&amp;#10;if mouse_in_box:&amp;#10;    if not in_start_box:  # Just entered the box&amp;#10;        hold_timer.reset()&amp;#10;        in_start_box = True&amp;#10;    &amp;#10;    # Check if hold time is complete (500ms)&amp;#10;    if hold_timer.getTime() &gt;= hold_duration:&amp;#10;        hold_complete = True&amp;#10;        start_box.fillColor = [-1, -1, -1]  # Change to black when hold complete&amp;#10;        continueRoutine = False  # End routine, move to next&amp;#10;else:&amp;#10;    # Reset if mouse leaves box before hold is complete&amp;#10;    in_start_box = False&amp;#10;    hold_timer.reset()&amp;#10;    start_box.fillColor = [-1, -1, 1]  # Back to blue&amp;#10;    &amp;#10;# Record mouse data every frame&amp;#10;current_pos = mouse_tracking.getPos()&amp;#10;current_time = mouse_track_clock.getTime()&amp;#10;mouse_track_data['x'].append(current_pos[0])&amp;#10;mouse_track_data['y'].append(current_pos[1])&amp;#10;mouse_track_data['time'].append(current_time)&amp;#10;&amp;#10;# Calculate velocity (if not first frame)&amp;#10;if len(mouse_track_data['time']) &gt; 1:&amp;#10;    dt = current_time - prev_time&amp;#10;    if dt &gt; 0:  # Avoid division by zero&amp;#10;        vx = (current_pos[0] - prev_x) / dt&amp;#10;        vy = (current_pos[1] - prev_y) / dt&amp;#10;    else:&amp;#10;        vx, vy = 0, 0&amp;#10;    mouse_track_data['velocity_x'].append(vx)&amp;#10;    mouse_track_data['velocity_y'].append(vy)&amp;#10;else:&amp;#10;    mouse_track_data['velocity_x'].append(0)&amp;#10;    mouse_track_data['velocity_y'].append(0)&amp;#10;&amp;#10;# Record clicks&amp;#10;buttons = mouse_tracking.getPressed()&amp;#10;mouse_track_data['clicks'].append(buttons[0])  # Left button&amp;#10;if buttons[0] == 1 and len(mouse_track_data['clicks']) &gt; 1 and mouse_track_data['clicks'][-2] == 0:&amp;#10;    # New click detected&amp;#10;    mouse_track_data['click_time'].append(current_time)&amp;#10;&amp;#10;# Update previous values for next frame&amp;#10;prev_x, prev_y = current_pos&amp;#10;prev_time = current_time" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (mouse_start.isPressedIn(start_box)) {&amp;#10;    if ((! in_start_box)) {&amp;#10;        hold_timer.reset();&amp;#10;        in_start_box = true;&amp;#10;        start_box.fillColor = [(- 1), (- 1), (- 1)];&amp;#10;    }&amp;#10;    if ((hold_timer.getTime() &gt;= hold_duration)) {&amp;#10;        hold_complete = true;&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;} else {&amp;#10;    in_start_box = false;&amp;#10;    hold_timer.reset();&amp;#10;    start_box.fillColor = [1, (- 1), (- 1)];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Record if hold was successful&amp;#10;thisExp.addData('hold_complete', hold_complete)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_11" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
