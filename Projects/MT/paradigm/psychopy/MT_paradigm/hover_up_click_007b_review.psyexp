      <CodeComponent name="code_15" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Set up possible ITI durations&amp;#10;possible_iti_durations = [0.5, 0.6, 0.7, 0.8, 0.9, 1.0]  # 500-1000ms in 100ms increments" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="possible_iti_durations = [0.5, 0.6, 0.7, 0.8, 0.9, 1.0];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="import * as random from 'random';&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;this_iti_duration = Math.random.choice(possible_iti_durations);&amp;#10;psychoJS.experiment.addData(&quot;iti_duration&quot;, this_iti_duration);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Hide the mouse cursor during ITI&amp;#10;win.mouseVisible = False&amp;#10;&amp;#10;# Choose a random ITI duration for this trial&amp;#10;import random&amp;#10;this_iti_duration = random.choice(possible_iti_durations)&amp;#10;thisExp.addData('iti_duration', this_iti_duration)  # Record the selected duration" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# Record mouse data every frame&amp;#10;current_pos = mouse_tracking.getPos()&amp;#10;current_time = mouse_track_clock.getTime()&amp;#10;mouse_track_data['x'].append(current_pos[0])&amp;#10;mouse_track_data['y'].append(current_pos[1])&amp;#10;mouse_track_data['time'].append(current_time)&amp;#10;&amp;#10;# Calculate velocity (if not first frame)&amp;#10;if len(mouse_track_data['time']) &gt; 1:&amp;#10;    dt = current_time - prev_time&amp;#10;    if dt &gt; 0:  # Avoid division by zero&amp;#10;        vx = (current_pos[0] - prev_x) / dt&amp;#10;        vy = (current_pos[1] - prev_y) / dt&amp;#10;    else:&amp;#10;        vx, vy = 0, 0&amp;#10;    mouse_track_data['velocity_x'].append(vx)&amp;#10;    mouse_track_data['velocity_y'].append(vy)&amp;#10;else:&amp;#10;    mouse_track_data['velocity_x'].append(0)&amp;#10;    mouse_track_data['velocity_y'].append(0)&amp;#10;&amp;#10;# Record clicks&amp;#10;buttons = mouse_tracking.getPressed()&amp;#10;mouse_track_data['clicks'].append(buttons[0])  # Left button&amp;#10;if buttons[0] == 1 and len(mouse_track_data['clicks']) &gt; 1 and mouse_track_data['clicks'][-2] == 0:&amp;#10;    # New click detected&amp;#10;    mouse_track_data['click_time'].append(current_time)&amp;#10;&amp;#10;# Update previous values for next frame&amp;#10;prev_x, prev_y = current_pos&amp;#10;prev_time = current_time" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="current_pos = mouse_tracking.getPos();&amp;#10;current_time = mouse_track_clock.getTime();&amp;#10;mouse_track_data[&quot;x&quot;].push(current_pos[0]);&amp;#10;mouse_track_data[&quot;y&quot;].push(current_pos[1]);&amp;#10;mouse_track_data[&quot;time&quot;].push(current_time);&amp;#10;if ((mouse_track_data[&quot;time&quot;].length &gt; 1)) {&amp;#10;    dt = (current_time - prev_time);&amp;#10;    if ((dt &gt; 0)) {&amp;#10;        vx = ((current_pos[0] - prev_x) / dt);&amp;#10;        vy = ((current_pos[1] - prev_y) / dt);&amp;#10;    } else {&amp;#10;        [vx, vy] = [0, 0];&amp;#10;    }&amp;#10;    mouse_track_data[&quot;velocity_x&quot;].push(vx);&amp;#10;    mouse_track_data[&quot;velocity_y&quot;].push(vy);&amp;#10;} else {&amp;#10;    mouse_track_data[&quot;velocity_x&quot;].push(0);&amp;#10;    mouse_track_data[&quot;velocity_y&quot;].push(0);&amp;#10;}&amp;#10;buttons = mouse_tracking.getPressed();&amp;#10;mouse_track_data[&quot;clicks&quot;].push(buttons[0]);&amp;#10;if ((((buttons[0] === 1) &amp;&amp; (mouse_track_data[&quot;clicks&quot;].length &gt; 1)) &amp;&amp; (mouse_track_data[&quot;clicks&quot;].slice((- 2))[0] === 0))) {&amp;#10;    mouse_track_data[&quot;click_time&quot;].push(current_time);&amp;#10;}&amp;#10;[prev_x, prev_y] = current_pos;&amp;#10;prev_time = current_time;&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = true;&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_x&quot;, mouse_track_data[&quot;x&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_y&quot;, mouse_track_data[&quot;y&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_time&quot;, mouse_track_data[&quot;time&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_velocity_x&quot;, mouse_track_data[&quot;velocity_x&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_velocity_y&quot;, mouse_track_data[&quot;velocity_y&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_clicks&quot;, mouse_track_data[&quot;clicks&quot;]);&amp;#10;psychoJS.experiment.addData(&quot;mouse_track_click_time&quot;, mouse_track_data[&quot;click_time&quot;]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Make mouse visible again and reset position&amp;#10;win.mouseVisible = True&amp;#10;# Save all tracked mouse data to experiment&amp;#10;thisExp.addData('mouse_track_x', mouse_track_data['x'])&amp;#10;thisExp.addData('mouse_track_y', mouse_track_data['y'])&amp;#10;thisExp.addData('mouse_track_time', mouse_track_data['time'])&amp;#10;thisExp.addData('mouse_track_velocity_x', mouse_track_data['velocity_x'])&amp;#10;thisExp.addData('mouse_track_velocity_y', mouse_track_data['velocity_y'])&amp;#10;thisExp.addData('mouse_track_clicks', mouse_track_data['clicks'])&amp;#10;thisExp.addData('mouse_track_click_time', mouse_track_data['click_time'])" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_15" valType="code" updates="None" name="name"/>
      </CodeComponent>
