      <CodeComponent name="code_14" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import numpy as np" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="trial_clock = new util.Clock();&amp;#10;max_response_time = 2.0;&amp;#10;mouse_positions = [];&amp;#10;mouse_timestamps = [];&amp;#10;response_made = false;&amp;#10;movement_continued = false;&amp;#10;movement_stopped = false;&amp;#10;last_positions = [];&amp;#10;still_duration = 0;&amp;#10;correct = false;&amp;#10;current_digit = Number.parseInt(digit);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Initialize variables for response tracking&amp;#10;trial_clock = core.Clock()&amp;#10;max_response_time = 2.0  # 2000ms max response time&amp;#10;&amp;#10;# Track mouse positions&amp;#10;mouse_positions = []&amp;#10;mouse_timestamps = []&amp;#10;&amp;#10;# Response tracking&amp;#10;response_made = False&amp;#10;movement_continued = False&amp;#10;movement_stopped = False&amp;#10;last_positions = []  # For tracking if movement has stopped&amp;#10;still_duration = 0&amp;#10;correct = False&amp;#10;&amp;#10;# Convert stimulus to correct type&amp;#10;current_digit = int(digit)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Record current position and time&amp;#10;current_pos = mouse_resp.getPos()&amp;#10;current_time = trial_clock.getTime()&amp;#10;mouse_positions.append(current_pos)&amp;#10;mouse_timestamps.append(current_time)&amp;#10;&amp;#10;# Add position to recent positions list (for checking if stopped)&amp;#10;last_positions.append(current_pos)&amp;#10;if len(last_positions) &gt; 15:  # Keep last ~250ms of positions (assuming 60Hz)&amp;#10;    last_positions.pop(0)&amp;#10;&amp;#10;# Check if mouse has reached response box (for Go trials)&amp;#10;if mouse_resp.isPressedIn(response_box_2) and not response_made:&amp;#10;    response_made = True&amp;#10;    rt = current_time&amp;#10;    &amp;#10;    # For Go trials, check if clicked in response box&amp;#10;    buttons = mouse_resp.getPressed()&amp;#10;    clicked_in_box = buttons[0] &gt; 0&amp;#10;    &amp;#10;    # For Go trials, movement and click is correct&amp;#10;    if trial_type == &quot;go&quot;:&amp;#10;        correct = clicked_in_box&amp;#10;    else:&amp;#10;        correct = False  # For NoGo trials, clicking is wrong&amp;#10;    &amp;#10;    # Record click position&amp;#10;    click_pos = current_pos&amp;#10;    thisExp.addData('response_box_clicked', clicked_in_box)&amp;#10;    thisExp.addData('click_pos_x', click_pos[0])&amp;#10;    thisExp.addData('click_pos_y', click_pos[1])&amp;#10;    &amp;#10;    continueRoutine = False&amp;#10;&amp;#10;# Check if movement has stopped (for No-Go trials)&amp;#10;if len(last_positions) &gt;= 15:&amp;#10;    # Calculate maximum movement distance in last samples&amp;#10;    pos_array = np.array(last_positions)&amp;#10;    max_distance = np.max(np.sqrt(np.sum((pos_array - pos_array[0])**2, axis=1)))&amp;#10;    &amp;#10;    if max_distance &lt; 5:  # Less than 5 pixels movement = stopped&amp;#10;        movement_stopped = True&amp;#10;        still_duration += 1/60  # Assuming 60Hz refresh rate&amp;#10;        &amp;#10;        # For No-Go trials, staying still for 500ms is correct&amp;#10;        if still_duration &gt;= 0.5 and trial_type == &quot;nogo&quot;:&amp;#10;            correct = True&amp;#10;            rt = current_time&amp;#10;            continueRoutine = False&amp;#10;    else:&amp;#10;        still_duration = 0&amp;#10;        movement_stopped = False&amp;#10;        movement_continued = True&amp;#10;&amp;#10;# Check if time has run out&amp;#10;if current_time &gt;= max_response_time:&amp;#10;    rt = max_response_time&amp;#10;    &amp;#10;    # For No-Go trials, not moving is correct&amp;#10;    if trial_type == &quot;nogo&quot; and not movement_continued:&amp;#10;        correct = True&amp;#10;    # For Go trials, not responding is incorrect&amp;#10;    elif trial_type == &quot;go&quot;:&amp;#10;        correct = False&amp;#10;    &amp;#10;    continueRoutine = False&amp;#10;    &amp;#10;# Record mouse data every frame&amp;#10;current_pos = mouse_tracking.getPos()&amp;#10;current_time = mouse_track_clock.getTime()&amp;#10;mouse_track_data['x'].append(current_pos[0])&amp;#10;mouse_track_data['y'].append(current_pos[1])&amp;#10;mouse_track_data['time'].append(current_time)&amp;#10;&amp;#10;# Calculate velocity (if not first frame)&amp;#10;if len(mouse_track_data['time']) &gt; 1:&amp;#10;    dt = current_time - prev_time&amp;#10;    if dt &gt; 0:  # Avoid division by zero&amp;#10;        vx = (current_pos[0] - prev_x) / dt&amp;#10;        vy = (current_pos[1] - prev_y) / dt&amp;#10;    else:&amp;#10;        vx, vy = 0, 0&amp;#10;    mouse_track_data['velocity_x'].append(vx)&amp;#10;    mouse_track_data['velocity_y'].append(vy)&amp;#10;else:&amp;#10;    mouse_track_data['velocity_x'].append(0)&amp;#10;    mouse_track_data['velocity_y'].append(0)&amp;#10;&amp;#10;# Record clicks&amp;#10;buttons = mouse_tracking.getPressed()&amp;#10;mouse_track_data['clicks'].append(buttons[0])  # Left button&amp;#10;if buttons[0] == 1 and len(mouse_track_data['clicks']) &gt; 1 and mouse_track_data['clicks'][-2] == 0:&amp;#10;    # New click detected&amp;#10;    mouse_track_data['click_time'].append(current_time)&amp;#10;&amp;#10;# Update previous values for next frame&amp;#10;prev_x, prev_y = current_pos&amp;#10;prev_time = current_time" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Save data&amp;#10;thisExp.addData('mouse_positions_x', [pos[0] for pos in mouse_positions])&amp;#10;thisExp.addData('mouse_positions_y', [pos[1] for pos in mouse_positions])&amp;#10;thisExp.addData('mouse_timestamps', mouse_timestamps)&amp;#10;thisExp.addData('response_made', response_made)&amp;#10;thisExp.addData('movement_continued', movement_continued)&amp;#10;thisExp.addData('movement_stopped', movement_stopped)&amp;#10;thisExp.addData('correct', correct)&amp;#10;thisExp.addData('rt', rt)&amp;#10;&amp;#10;&amp;#10;# Calculate additional mouse metrics&amp;#10;if len(mouse_positions) &gt; 1:&amp;#10;    # Convert to numpy arrays for calculations&amp;#10;    pos_array = np.array(mouse_positions)&amp;#10;    times_array = np.array(mouse_timestamps)&amp;#10;    &amp;#10;    # Path length (total distance traveled)&amp;#10;    diffs = np.diff(pos_array, axis=0)&amp;#10;    path_length = np.sum(np.sqrt(np.sum(diffs**2, axis=1)))&amp;#10;    &amp;#10;    # Maximum deviation from straight line&amp;#10;    if len(pos_array) &gt; 2:&amp;#10;        start_point = pos_array[0]&amp;#10;        end_point = pos_array[-1]&amp;#10;        # Vector from start to end&amp;#10;        direct_vector = end_point - start_point&amp;#10;        direct_length = np.sqrt(np.sum(direct_vector**2))&amp;#10;        &amp;#10;        if direct_length &gt; 0:  # Avoid division by zero&amp;#10;            # Normalized vector&amp;#10;            direct_norm = direct_vector / direct_length&amp;#10;            &amp;#10;            # For each point, calculate perpendicular distance to direct path&amp;#10;            deviations = []&amp;#10;            for point in pos_array:&amp;#10;                # Vector from start to point&amp;#10;                to_point = point - start_point&amp;#10;                # Project to_point onto direct_norm&amp;#10;                projection_length = np.dot(to_point, direct_norm)&amp;#10;                # Calculate projection point&amp;#10;                projection_point = start_point + projection_length * direct_norm&amp;#10;                # Calculate deviation (perpendicular distance)&amp;#10;                deviation = np.sqrt(np.sum((point - projection_point)**2))&amp;#10;                deviations.append(deviation)&amp;#10;            &amp;#10;            max_deviation = np.max(deviations)&amp;#10;        else:&amp;#10;            max_deviation = 0&amp;#10;    else:&amp;#10;        max_deviation = 0&amp;#10;    &amp;#10;    # Area under curve&amp;#10;    auc = 0&amp;#10;    if len(deviations) &gt; 0:&amp;#10;        auc = np.sum(deviations) / len(deviations)&amp;#10;    &amp;#10;    # Number of direction changes (X and Y separately)&amp;#10;    x_dirs = np.sign(np.diff(pos_array[:, 0]))&amp;#10;    y_dirs = np.sign(np.diff(pos_array[:, 1]))&amp;#10;    x_changes = np.sum(np.abs(np.diff(x_dirs)) &gt; 0)&amp;#10;    y_changes = np.sum(np.abs(np.diff(y_dirs)) &gt; 0)&amp;#10;    &amp;#10;    # Calculate acceleration&amp;#10;    if len(times_array) &gt; 2:&amp;#10;        dt = np.diff(times_array)&amp;#10;        velocities = np.diff(pos_array, axis=0)&amp;#10;        valid_dts = dt &gt; 0  # Avoid division by zero&amp;#10;        &amp;#10;        v_x = np.zeros(len(dt))&amp;#10;        v_y = np.zeros(len(dt))&amp;#10;        &amp;#10;        v_x[valid_dts] = velocities[valid_dts, 0] / dt[valid_dts]&amp;#10;        v_y[valid_dts] = velocities[valid_dts, 1] / dt[valid_dts]&amp;#10;        &amp;#10;        # Acceleration (change in velocity)&amp;#10;        a_x = np.diff(v_x)&amp;#10;        a_y = np.diff(v_y)&amp;#10;        &amp;#10;        # Peak acceleration&amp;#10;        peak_acceleration = np.max(np.sqrt(a_x**2 + a_y**2))&amp;#10;    else:&amp;#10;        peak_acceleration = 0&amp;#10;    &amp;#10;    # Save all metrics&amp;#10;    thisExp.addData('path_length', path_length)&amp;#10;    thisExp.addData('max_deviation', max_deviation)&amp;#10;    thisExp.addData('auc', auc)&amp;#10;    thisExp.addData('x_direction_changes', x_changes)&amp;#10;    thisExp.addData('y_direction_changes', y_changes)&amp;#10;    thisExp.addData('peak_acceleration', peak_acceleration)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_14" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="ITI_prac">
      <RoutineSettingsComponent name="ITI_prac" plugin="None">
